# ─── Server ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Encryption ────────────────────────────────────────────────────────────────
# Must be exactly 32 bytes, base64-encoded.
# Generate: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ─── Source Database ───────────────────────────────────────────────────────────
PROD_SOURCE_DB_URI=postgresql+asyncpg://user:password@localhost:5432/sourcedb

# ─── Target Database ──────────────────────────────────────────────────────────
PROD_TARGET_DB_URI=postgresql+asyncpg://user:password@localhost:5432/targetdb

# ─── AWS Credentials (for S3 destination) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-east-1

# ─── HashiCorp Vault (optional) ───────────────────────────────────────────────
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=REPLACE_ME

# ─── MongoDB (optional NoSQL connector) ───────────────────────────────────────
MONGO_URI=mongodb://localhost:27017

# ─── App Settings ─────────────────────────────────────────────────────────────
STATE_DB_PATH=./state.db
LOG_LEVEL=INFO
MAX_MEMORY_PERCENT=75.0
MAX_CPU_PERCENT=75.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:3000"]

